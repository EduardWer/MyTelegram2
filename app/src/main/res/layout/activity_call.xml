<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:keepScreenOn="true">

    <!-- Фон с аватаром звонящего -->
    <ImageView
        android:id="@+id/background_avatar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        android:src="@drawable/ic_person" />

    <!-- Затемнение -->
    <View
        android:id="@+id/dim_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Информация о звонящем (для аудио звонков) -->
    <LinearLayout
        android:id="@+id/caller_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:visibility="visible">

        <!-- Аватар звонящего -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/caller_avatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_person"
            app:civ_border_width="3dp"
            app:civ_border_color="#FFFFFF" />

        <!-- Имя звонящего -->
        <TextView
            android:id="@+id/caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Иван Петров"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <!-- Статус звонка -->
        <TextView
            android:id="@+id/call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="В разговоре"
            android:textColor="#4CAF50"
            android:textSize="16sp" />

        <!-- Таймер звонка -->
        <TextView
            android:id="@+id/call_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:fontFamily="monospace"
            android:visibility="visible" />

    </LinearLayout>

    <!-- Кнопки управления звонком для аудио режима -->
    <LinearLayout
        android:id="@+id/call_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_speaker"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_speaker"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Динамик"
                android:padding="12dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Динамик"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_microphone"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Микрофон"
                android:padding="12dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Микрофон"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_video"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_video_call"
                android:background="@drawable/circle_button_bg"
                android:contentDescription="Видео"
                android:padding="12dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Видео"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btn_end_call"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_call"
                android:background="@drawable/decline_button_bg"
                android:contentDescription="Завершить"
                android:padding="12dp"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Завершить"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Видеопревью (для видеозвонков) -->
    <FrameLayout
        android:id="@+id/video_preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Видео собеседника (на весь экран) -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/remote_video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:keepScreenOn="true" />

        <!-- Своё видео (маленькое окно в углу) -->
        <FrameLayout
            android:id="@+id/local_video_container"
            android:layout_width="120dp"
            android:layout_height="160dp"
            android:layout_margin="16dp"
            android:layout_gravity="top|end"
            android:background="#000000"
            android:visibility="gone"
            android:elevation="8dp">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/local_video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Рамка вокруг своего видео -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/video_border" />

        </FrameLayout>

        <!-- Кнопки управления поверх видео - теперь вне FrameLayout -->
    </FrameLayout>

    <!-- ✅ КНОПКИ УПРАВЛЕНИЯ ВИДЕО - ОТДЕЛЬНО от video_preview_container -->
    <LinearLayout
        android:id="@+id/video_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:visibility="gone"
        android:elevation="10dp">

        <ImageButton
            android:id="@+id/btn_video_speaker"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_button_bg"
            android:padding="12dp"
            android:src="@drawable/ic_speaker"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_video_mute"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_button_bg"
            android:padding="12dp"
            android:src="@drawable/ic_microphone"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_switch_camera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:background="@drawable/circle_button_bg"
            android:padding="12dp"
            android:src="@drawable/ic_switch_camera"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_video_end_call"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="8dp"
            android:background="@drawable/decline_button_bg"
            android:padding="12dp"
            android:src="@drawable/ic_call"
            app:tint="#FFFFFF" />

    </LinearLayout>

</RelativeLayout>