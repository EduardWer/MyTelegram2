<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f5f5f5"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Видеоконференция"
        android:textColor="#333"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <!-- Информация о пользователе -->
    <TextView
        android:id="@+id/tv_current_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Вы: Гость"
        android:textColor="#666"
        android:textSize="16sp"
        android:layout_marginBottom="48dp" />

    <!-- Код комнаты -->
    <EditText
        android:id="@+id/et_room_code"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/edit_text_background"
        android:gravity="center"
        android:hint="Введите код комнаты"
        android:inputType="textCapCharacters"
        android:maxLength="6"
        android:textColor="@color/black"
        android:textColorHint="#999"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <!-- Кнопка подключения -->
    <Button
        android:id="@+id/btn_join_room"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#2196F3"
        android:text="Подключиться"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <!-- Разделитель -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ddd"
            android:layout_centerVertical="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:background="#f5f5f5"
            android:paddingHorizontal="16dp"
            android:text="или"
            android:textColor="#546E7A" />

    </RelativeLayout>

    <!-- Кнопка создания комнаты -->
    <Button
        android:id="@+id/btn_create_room"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="#4CAF50"
        android:text="Создать новую комнату"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <!-- Прогресс бар -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

</LinearLayout>