<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a1a">

    <!-- Контейнер для видео участников -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_controls">

        <!-- Статус (добавлено) -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="60dp"
            android:background="#99000000"
            android:padding="12dp"
            android:text="Подключение..."
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- Основное видео (активный спикер или сетка) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_participants"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

        <!-- Локальное видео (поверх основного) -->
        <FrameLayout
            android:id="@+id/local_video_container"
            android:layout_width="120dp"
            android:layout_height="160dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/video_border"
            android:elevation="8dp">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/local_video_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

    </FrameLayout>

    <!-- Чат (скрыт по умолчанию) -->
    <LinearLayout
        android:id="@+id/chat_container"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_above="@+id/bottom_controls"
        android:background="#e62d2d2d"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Чат конференции"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/message_background_received"
                android:hint="Сообщение..."
                android:padding="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="#999" />

            <Button
                android:id="@+id/btn_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#4CAF50"
                android:text="Отправить"
                android:textColor="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

    <!-- Нижняя панель управления -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#cc000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Код комнаты -->
        <TextView
            android:id="@+id/tv_room_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Комната: ------"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <!-- Кнопки управления -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Управление аудио -->
            <ImageButton
                android:id="@+id/btn_toggle_audio"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_microphone"
                android:contentDescription="Микрофон" />

            <!-- Управление видео -->
            <ImageButton
                android:id="@+id/btn_toggle_video"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_videocam"
                android:contentDescription="Камера" />

            <!-- Завершение звонка -->
            <ImageButton
                android:id="@+id/btn_end_call"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_message_sent"
                android:src="@drawable/ic_call_end"
                android:contentDescription="Завершить" />

            <!-- Переключение камеры -->
            <ImageButton
                android:id="@+id/btn_switch_camera"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_switch_camera"
                android:contentDescription="Сменить камеру" />

            <!-- Чат -->
            <ImageButton
                android:id="@+id/btn_chat"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                android:background="@drawable/circle_button_bg"
                android:src="@drawable/ic_send"
                android:contentDescription="Чат" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>