<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ChatActivity">

    <!-- Верхняя панель с информацией о чате -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#FF6200EE"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <!-- Кнопка назад -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="Назад"
            app:tint="@color/white" />

        <!-- Аватар пользователя -->
        <ImageView
            android:id="@+id/userAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_person"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:layout_marginStart="12dp"
            android:contentDescription="Аватар пользователя" />

        <!-- Информация о пользователе -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/userName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Имя пользователя"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/userStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="был(а) недавно"
                android:textColor="#E0E0E0"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Прогресс загрузки файлов -->
    <LinearLayout
        android:id="@+id/uploadProgressLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#E3F2FD"
        android:visibility="gone"
        android:layout_below="@+id/topBar">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_file_upload"
            android:layout_marginEnd="8dp"
            app:tint="#4285F4" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/uploadFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Загрузка файла..."
                android:textSize="14sp"
                android:textColor="#333333"
                android:maxLines="1"
                android:ellipsize="end" />

            <ProgressBar
                android:id="@+id/uploadProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/uploadProgressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/cancelUploadButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="8dp"
            app:tint="#666666" />

    </LinearLayout>

    <!-- RecyclerView для сообщений -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:background="@color/white"
        android:scrollbars="vertical"
        android:layout_below="@+id/uploadProgressLayout"
        android:layout_above="@+id/inputLayout"/>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="175dp"
        android:layout_height="164dp"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Панель ввода сообщения -->
    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#D7D7D7"
        android:layout_alignParentBottom="true">

        <!-- Кнопка выбора файлов -->
        <ImageButton
            android:id="@+id/photoButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_attach_file"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:contentDescription="Прикрепить файл"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/messageEditText"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/edit_text_background"
            android:hint="Введите сообщение"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#000000"
            android:textColorHint="#757575" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="#FF6200EE"
            android:src="@drawable/ic_send"
            android:scaleType="center"
            android:contentDescription="Отправить" />
    </LinearLayout>

</RelativeLayout>